# Copy this file to scripts/.env.server and fill in real values.
# scripts/.env.server is gitignored (matches ".env.*" in .gitignore) and must
# never be committed. Do not paste real credentials into chat either -- edit
# this file directly.

SFTP_HOST=your.host.example.com
SFTP_PORT=22
SFTP_USER=your-sftp-username
SFTP_PASSWORD=your-sftp-password

# curl refuses to connect over SFTP without verifying the server's SSH host
# key. Run scripts/get-host-fingerprint.ps1 (fill in host/port above first)
# to fetch and print it, then paste the SHA256 value it reports here.
# Note: it prints one fingerprint per host key type (RSA/ECDSA/ed25519) --
# use the one curl reports as "Remote ..." if a first connection attempt
# fails with a mismatch, since the negotiated key type varies by server.
SFTP_HOST_FINGERPRINT_SHA256=

# Remote paths, relative to the root your SFTP login lands in.
# Use `curl -sS --user USER:PASS sftp://HOST:PORT/` (trailing slash) to list
# the root and find the real paths if you're not sure -- hosting providers
# vary here (e.g. one confirmed layout: server-data/mods/<modname>,
# server-data/Logs, server-data/server-console.txt).
REMOTE_MODS_DIR=mods/pz-zombie-factions
REMOTE_LOGS_DIR=Logs
REMOTE_CONSOLE_LOG=console.txt
